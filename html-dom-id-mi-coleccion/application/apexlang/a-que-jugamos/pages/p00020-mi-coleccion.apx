page 20 (
    name: Mi colección
    alias: MI-COLECCION
    title: Mi colección
    pageGroup: @experimento-nl2ir
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* A single region: use its HTML DOM ID, not its component Static ID. */
            #collection_intro {
                background: #f5f0e7;
                color: #183d38;
                border: 1px solid #e5ded1;
                border-radius: 1rem;
                overflow: hidden;
            }

            /* Own content classes, scoped to this region. */
            #collection_intro .collection-hero {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
                padding: 1.75rem 2rem;
            }

            #collection_intro .collection-copy {
                min-width: 0;
            }

            #collection_intro .collection-eyebrow {
                margin: 0 0 .6rem;
                color: #426b60;
                font-size: .8rem;
                font-weight: 600;
                letter-spacing: .1em;
                text-transform: uppercase;
            }

            #collection_intro h2 {
                margin: 0;
                color: inherit;
                font-size: clamp(1.6rem, 2.5vw, 2.25rem);
                font-weight: 600;
                line-height: 1.2;
                letter-spacing: -.025em;
            }

            #collection_intro .collection-description {
                margin: .75rem 0 0;
                color: #426057;
                max-width: 48ch;
            }

            #collection_intro .collection-art {
                width: 260px;
                max-width: 35%;
                flex-shrink: 0;
                display: block;
            }

            /* Keep the report's own toolbar, columns and controls. */
            #my_collection {
                margin-block-start: 1.25rem;
            }

            @media (max-width: 640px) {
                #collection_intro .collection-hero { padding: 1.5rem; }
                #collection_intro .collection-art { display: none; }
            }

            ```
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Primeros ajustes visuales de Mi colección mediante HTML DOM ID y CSS propio.
    }

    region v4-hero (
        name: Bienvenida a mi colección
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="collection-hero">
                    <div class="collection-copy">
                        <p class="collection-eyebrow">Mi colección</p>
                        <h2>Tu próxima partida, a mano.</h2>
                        <p class="collection-description">Explora tus juegos y encuentra qué sacar a la mesa.</p>
                    </div>
                    <svg class="collection-art" viewBox="0 0 300 160" aria-hidden="true" focusable="false">
                        <ellipse cx="160" cy="142" rx="112" ry="9" fill="#173f39" opacity=".08"/>
                        <g transform="translate(104 18) rotate(12 60 60)">
                            <rect width="112" height="112" rx="22" fill="#d8e3d7"/>
                            <path d="M20 35H92M20 57H92M20 79H92M35 20V92M57 20V92M79 20V92" stroke="#91b0a0" stroke-width="2"/>
                        </g>
                        <g transform="translate(48 65) rotate(-12 38 38)">
                            <rect width="76" height="76" rx="17" fill="#fffdf7" stroke="#d8d2c5"/>
                            <g fill="#285a50">
                                <circle cx="23" cy="23" r="5"/><circle cx="53" cy="23" r="5"/>
                                <circle cx="38" cy="38" r="5"/>
                                <circle cx="23" cy="53" r="5"/><circle cx="53" cy="53" r="5"/>
                            </g>
                        </g>
                        <g fill="#285a50">
                            <circle cx="236" cy="91" r="12"/>
                            <path d="M224 106Q236 98 248 106L255 137H217Z"/>
                        </g>
                        <ellipse cx="180" cy="131" rx="19" ry="8" fill="#b98342"/>
                        <ellipse cx="180" cy="124" rx="19" ry="8" fill="#ddb578"/>
                        <circle cx="59" cy="35" r="5" fill="#b98342"/>
                        <path d="M250 38v12m-6-6h12" stroke="#91b0a0" stroke-width="3" stroke-linecap="round"/>
                    </svg>
                </div>

                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            icon: fa-strategy
        }
        advanced {
            htmlDomId: collection_intro
        }
    )

    region v4-report (
        name: Mi colección
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.game_id
                     , l.title
                     , l.edition_ruleset
                     , l.cultural_scope
                     , l.game_type_code
                     , l.play_mode_code
                     , l.min_players
                     , l.max_players
                     , l.reference_duration_min
                     , l.complexity_code
                     , l.language_dep_code
                     , l.play_count
                     , l.avg_duration_min
                     , l.duration_drift_min
                     , l.played_yn
                  from nl2ir_v_library l
                 order by l.title
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: my_collection
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No hay juegos que coincidan con la configuración actual del informe.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# filas. Aplica algún filtro para acotar el resultado.
        }
        genAI {
            naturalLanguageSupport: true
            reportContext: Cada fila representa un juego de una colección personal. Las partidas registradas son sintéticas y sólo se utilizan para este laboratorio. No hay valoraciones, precios ni datos externos.
        }
        download {
            formats: csv
        }
        advanced {
            savedReportMappingIdentifier: 71400805531471070
        }

        column AVG_DURATION_MIN (
            type: plainText
            heading {
                heading: Duración media en minutos
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
            genAI {
                columnContext: Media de duración de las partidas completadas, expresada en minutos. Puede estar vacía si no hay partidas.
            }
        )

        column COMPLEXITY_CODE (
            type: plainText
            heading {
                heading: Complejidad
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
            genAI {
                columnContext: Nivel aproximado de dificultad. Usa LIGHT para ligero o sencillo, MEDIUM para medio o intermedio y HEAVY para complejo o exigente.
                referenceDataType: sharedComponent
                lov: @nl2ir-ai-complexity-codes
            }
        )

        column CULTURAL_SCOPE (
            type: plainText
            heading {
                heading: Ámbito
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            genAI {
                columnContext: Ámbito cultural con el que se asocia el juego en este conjunto de datos; no mide popularidad.
            }
        )

        column DURATION_DRIFT_MIN (
            type: plainText
            heading {
                heading: Desviación de duración en minutos
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
            genAI {
                columnContext: Diferencia en minutos entre la duración media observada y la duración de referencia. Un valor positivo indica que las partidas suelen alargarse; uno negativo, que suelen terminar antes.
            }
        )

        column EDITION_RULESET (
            type: plainText
            heading {
                heading: Edición o reglas
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            genAI {
                columnContext: Edición comercial concreta o variante de reglas fijada para el laboratorio; no presupone unas reglas universales.
            }
        )

        column GAME_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column GAME_TYPE_CODE (
            type: plainText
            heading {
                heading: Tipo de juego
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            genAI {
                columnContext: Clasificación general del juego. Usa TRAD_CARD para cartas tradicionales, TRAD_BOARD para tablero tradicional, FAMILY para familiar, STRATEGY para estrategia, PARTY para fiesta y FILLER para un juego breve y fácil de sacar a mesa.
                referenceDataType: sharedComponent
                lov: @nl2ir-ai-game-type-codes
            }
        )

        column LANGUAGE_DEP_CODE (
            type: plainText
            heading {
                heading: Dependencia del idioma
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
            genAI {
                columnContext: Cantidad de texto que hace falta comprender durante la partida. Usa NONE para ninguna, LOW para baja o poca, MEDIUM para media y HIGH para alta o mucha. Sin depender mucho del idioma incluye NONE o LOW.
                referenceDataType: sharedComponent
                lov: @nl2ir-ai-language-dependence-codes
            }
        )

        column MAX_PLAYERS (
            type: plainText
            heading {
                heading: Máximo de jugadores
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            genAI {
                columnContext: Para que un juego admita a N personas, este valor debe ser mayor o igual que N.
            }
        )

        column MIN_PLAYERS (
            type: plainText
            heading {
                heading: Mínimo de jugadores
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            genAI {
                columnContext: Para que un juego admita a N personas, este valor debe ser menor o igual que N.
            }
        )

        column PLAYED_YN (
            type: plainText
            heading {
                heading: Jugado
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
            genAI {
                columnContext: Usa Y cuando hay al menos una partida completada y N cuando no hay ninguna. Sí, yes y bai significan Y; no y ez significan N.
                referenceDataType: sharedComponent
                lov: @nl2ir-ai-played-codes
            }
        )

        column PLAY_COUNT (
            type: plainText
            heading {
                heading: Partidas completadas
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
            genAI {
                columnContext: Número de sesiones completadas registradas. Un valor cero significa que el juego todavía no ha tocado mesa.
            }
        )

        column PLAY_MODE_CODE (
            type: plainText
            heading {
                heading: Modo de juego
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
            genAI {
                columnContext: Indica cómo interactúan las personas. Usa COMP para competitivo, COOP para cooperativo o sin competir, TEAM para por equipos y MIXED para modalidad mixta.
                referenceDataType: sharedComponent
                lov: @nl2ir-ai-play-mode-codes
            }
        )

        column REFERENCE_DURATION_MIN (
            type: plainText
            heading {
                heading: Duración de referencia en minutos
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
            genAI {
                columnContext: Duración orientativa de una partida, expresada siempre en minutos. Menos de una hora significa menos de 60.
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Juego
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            genAI {
                columnContext: Nombre del juego o de la edición incluida en la colección.
            }
        )

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AVG_DURATION_MIN (
                sequence: 13
            )

            displayColumn COMPLEXITY_CODE (
                sequence: 10
            )

            displayColumn CULTURAL_SCOPE (
                sequence: 4
            )

            displayColumn DURATION_DRIFT_MIN (
                sequence: 14
            )

            displayColumn EDITION_RULESET (
                sequence: 3
            )

            displayColumn GAME_ID (
                sequence: 1
            )

            displayColumn GAME_TYPE_CODE (
                sequence: 5
            )

            displayColumn LANGUAGE_DEP_CODE (
                sequence: 11
            )

            displayColumn MAX_PLAYERS (
                sequence: 8
            )

            displayColumn MIN_PLAYERS (
                sequence: 7
            )

            displayColumn PLAYED_YN (
                sequence: 15
            )

            displayColumn PLAY_COUNT (
                sequence: 12
            )

            displayColumn PLAY_MODE_CODE (
                sequence: 6
            )

            displayColumn REFERENCE_DURATION_MIN (
                sequence: 9
            )

            displayColumn TITLE (
                sequence: 2
            )

        )

    )

)
