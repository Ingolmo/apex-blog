page 1 (
    name: Inicio
    alias: HOME
    title: ¿A qué jugamos?
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region home-hero (
        name: ¿A qué jugamos?
        type: staticContent
        source {
            htmlCode: <p>Un laboratorio pequeño para explorar informes, contexto y acciones sobre una colección ficticia de juegos de mesa.</p>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region home-navigation (
        name: Elige un recorrido
        type: list
        source {
            list: @home-navigation
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--cols
                t-Cards--hideBody
                t-Cards--animColorFill
            ]
        }
    )

)
