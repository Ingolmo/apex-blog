page 2 (
    name: Evaluar NL2IR
    alias: EVALUAR-NL2IR
    title: Evaluar NL2IR
    pageGroup: @experimento-nl2ir
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Compara las cinco iteraciones del mismo informe. Cada etapa mejora únicamente la información que APEX entrega al asistente de lenguaje natural.
    }

    region nl2ir-hero (
        name: Evaluar NL2IR
        type: staticContent
        source {
            htmlCode: <p>Recorre la misma colección desde los metadatos técnicos hasta las columnas derivadas y observa qué cambia al preguntar en lenguaje natural.</p>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region nl2ir-iterations (
        name: Las cinco etapas
        type: list
        source {
            list: @nl2ir-iterations
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                t-Cards--hideBody
                t-Cards--animColorFill
            ]
        }
    )

)
