page 8 (
    name: Preparar propuesta
    alias: PREPARAR-PROPUESTA
    title: Preparar propuesta
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Reutiliza la vista V4 sin lenguaje natural. El objetivo es seleccionar filas del informe y añadir los juegos elegidos a una propuesta de partida.
    }

    region bulk-games-report (
        name: Juegos para la propuesta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.game_id
                     , l.title
                     , l.edition_ruleset
                     , l.cultural_scope
                     , l.game_type_code
                     , l.play_mode_code
                     , l.min_players
                     , l.max_players
                     , l.reference_duration_min
                     , l.complexity_code
                     , l.language_dep_code
                     , l.play_count
                     , l.avg_duration_min
                     , l.duration_drift_min
                     , l.played_yn
                  from nl2ir_v_library l
                 order by l.title
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No hay juegos que coincidan con la configuración actual del informe.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# filas. Aplica algún filtro para acotar el resultado.
        }
        download {
            formats: csv
        }
        advanced {
            savedReportMappingIdentifier: 29282055075367914
        }

        column APEX$ROW_SELECTOR (
            type: rowSelector
            rowSelection {
                enableMultiSelect: true
                showSelectAll: true
                hideControl: false
                currentSelectionPageItem: P8_SELECTED_GAME_IDS
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column AVG_DURATION_MIN (
            type: plainText
            heading {
                heading: Duración media en minutos
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column COMPLEXITY_CODE (
            type: plainText
            heading {
                heading: Complejidad
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CULTURAL_SCOPE (
            type: plainText
            heading {
                heading: Ámbito
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DURATION_DRIFT_MIN (
            type: plainText
            heading {
                heading: Desviación de duración en minutos
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column EDITION_RULESET (
            type: plainText
            heading {
                heading: Edición o reglas
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column GAME_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column GAME_TYPE_CODE (
            type: plainText
            heading {
                heading: Tipo de juego
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LANGUAGE_DEP_CODE (
            type: plainText
            heading {
                heading: Dependencia del idioma
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column MAX_PLAYERS (
            type: plainText
            heading {
                heading: Máximo de jugadores
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column MIN_PLAYERS (
            type: plainText
            heading {
                heading: Mínimo de jugadores
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column PLAYED_YN (
            type: plainText
            heading {
                heading: Jugado
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {case PLAYED_YN/}
                      {when Y/}
                        <span class="fa fa-check-circle-o"
                              style="color: var(--ut-palette-success);"
                              aria-label="Sí"></span>
                      {otherwise/}
                        <span class="fa fa-times-circle-o"
                              style="color: var(--ut-palette-danger);"
                              aria-label="No"></span>
                    {endcase/}
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column PLAY_COUNT (
            type: plainText
            heading {
                heading: Partidas completadas
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column PLAY_MODE_CODE (
            type: plainText
            heading {
                heading: Modo de juego
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REFERENCE_DURATION_MIN (
            type: plainText
            heading {
                heading: Duración de referencia en minutos
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Juego
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AVG_DURATION_MIN (
                sequence: 13
            )

            displayColumn COMPLEXITY_CODE (
                sequence: 10
            )

            displayColumn CULTURAL_SCOPE (
                sequence: 4
            )

            displayColumn DURATION_DRIFT_MIN (
                sequence: 14
            )

            displayColumn EDITION_RULESET (
                sequence: 3
            )

            displayColumn GAME_ID (
                sequence: 1
            )

            displayColumn GAME_TYPE_CODE (
                sequence: 5
            )

            displayColumn LANGUAGE_DEP_CODE (
                sequence: 11
            )

            displayColumn MAX_PLAYERS (
                sequence: 8
            )

            displayColumn MIN_PLAYERS (
                sequence: 7
            )

            displayColumn PLAYED_YN (
                sequence: 15
            )

            displayColumn PLAY_COUNT (
                sequence: 12
            )

            displayColumn PLAY_MODE_CODE (
                sequence: 6
            )

            displayColumn REFERENCE_DURATION_MIN (
                sequence: 9
            )

            displayColumn TITLE (
                sequence: 2
            )

        )

    )

    region bulk-hero (
        name: Preparar propuesta
        type: staticContent
        source {
            htmlCode: <p>Selecciona los juegos que quieres llevar a la mesa.</p>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-check-square-o
        }
    )

    region selección-para-enviar (
        name: Selección para enviar
        title: Selección para enviar
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P8_SELECTED_GAME_IDS (
        type: textField
        label {
            label: Juegos seleccionados para enviar
            alignment: left
        }
        layout {
            sequence: 10
            region: @selección-para-enviar
            slot: regionBody
            alignment: left
            columnSpan: 10
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            inlineHelpText: Muestra la selección que se enviará a base de datos al procesar la propuesta.
        }
    )

    button add-to-proposal (
        buttonName: ADD_TO_PROPOSAL
        label: Añadir a la propuesta
        layout {
            sequence: 20
            region: @selección-para-enviar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction confirmar-selección-antes-de-procesar (
        name: Confirmar selección antes de procesar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @add-to-proposal
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P8_SELECTED_GAME_IDS
        }

        action native-alert (
            action: alert
            settings {
                message: Selecciona al menos un juego…
                style: information
                icon: fa-info
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-confirm (
            action: confirm
            settings {
                message: Se enviarán los juegos seleccionados a la propuesta. ¿Quieres continuar?
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ADD_TO_PROPOSAL
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process añadir-selección-a-propuesta (
        name: Añadir selección a propuesta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_night_id number;
                begin
                  l_night_id := nl2ir_game_night_api.ensure_draft(:APP_USER);
                  nl2ir_game_night_api.add_options(
                    p_night_id   => l_night_id,
                    p_owner_user => :APP_USER,
                    p_game_ids   => :P8_SELECTED_GAME_IDS
                  );

                  :P8_SELECTED_GAME_IDS := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Selección procesada. Los juegos ya presentes se han conservado sin duplicarlos.
        }
        advanced {
            executionMappingIdentifier: 32244351664459902
        }
        serverSideCondition {
            whenButtonPressed: @add-to-proposal
        }
    )

)
