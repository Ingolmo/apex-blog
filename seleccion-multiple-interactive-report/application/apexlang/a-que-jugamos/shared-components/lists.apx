        label: V0 · Metadatos técnicos
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry v1 (
        label: V1 · Columnas comprensibles
        icon {
            imageIconCssClasses: fa-columns
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry v2 (
        label: V2 · Contexto
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry v3 (
        label: V3 · Valores de referencia
        icon {
            imageIconCssClasses: fa-list-ul
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry v4 (
        label: V4 · Columnas derivadas
        icon {
            imageIconCssClasses: fa-strategy
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 7
            }
        }
    )

)
