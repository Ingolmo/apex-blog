list home-navigation (
    name: Navegación de inicio

    entry evaluate-nl2ir (
        label: Evaluar NL2IR
        icon {
            imageIconCssClasses: fa-flask
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry prepare-game-night (
        label: Seleccionar filas
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 8
            }
        }
    )

)

list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Cerrar sesión
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry evaluate-nl2ir (
        label: Evaluar NL2IR
        icon {
            imageIconCssClasses: fa-flask
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry home (
        label: Inicio
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry prepare-game-night (
        label: Preparar propuesta
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 8
            }
        }
    )

    entry v0 (
        label: V0 · Metadatos técnicos
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 30
            parentEntry: @evaluate-nl2ir
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry v1 (
        label: V1 · Columnas comprensibles
        icon {
            imageIconCssClasses: fa-columns
        }
        layout {
            sequence: 40
            parentEntry: @evaluate-nl2ir
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry v2 (
        label: V2 · Contexto
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 50
            parentEntry: @evaluate-nl2ir
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry v3 (
        label: V3 · Valores de referencia
        icon {
            imageIconCssClasses: fa-list-ul
        }
        layout {
            sequence: 60
            parentEntry: @evaluate-nl2ir
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry v4 (
        label: V4 · Columnas derivadas
        icon {
            imageIconCssClasses: fa-strategy
        }
        layout {
            sequence: 70
            parentEntry: @evaluate-nl2ir
        }
        link {
            target: {
                page: 7
            }
        }
    )

)

list nl2ir-iterations (
    name: Etapas de NL2IR

