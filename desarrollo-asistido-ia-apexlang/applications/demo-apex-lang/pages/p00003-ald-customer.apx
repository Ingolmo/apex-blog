page 3 (
    name: Ald Customer
    alias: ALD-CUSTOMER
    title: Ald Customer
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ald-customer (
        name: Ald Customer
        type: form
        source {
            location: localDatabase
            tableName: ALD_CUSTOMERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_CONTACT_CHANNEL (
        type: selectList
        label {
            label: Contact Channel
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @contact-channel
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @ald-customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @ald-customer
            column: CONTACT_CHANNEL
            dataType: varchar2
        }
    )

    pageItem P3_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @ald-customer
            slot: regionBody
        }
        source {
            formRegion: @ald-customer
            column: CUSTOMER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_CUSTOMER_NAME (
        type: textField
        label {
            label: Customer Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @ald-customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @ald-customer
            column: CUSTOMER_NAME
            dataType: varchar2
        }
    )

    pageItem P3_EMAIL (
        type: textarea
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 40
            region: @ald-customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 320
        }
        source {
            formRegion: @ald-customer
            column: EMAIL
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_CUSTOMER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_CUSTOMER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_CUSTOMER_ID
        }
    )

    validation VAL_EMAIL_REQUIRED_FOR_EMAIL_CHANNEL (
        name: Email required for Email channel
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P3_EMAIL
        }
        error {
            errorMessage: Introduce una dirección de correo electrónico cuando el canal de contacto sea Email.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P3_EMAIL
        }
        serverSideCondition {
            type: item=value
            item: P3_CONTACT_CHANNEL
            value: EMAIL
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 25988416508702236
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-ald-customer (
        name: Initialize form Ald Customer
        type: formInitialization
        formRegion: @ald-customer
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25987610586702236
        }
    )

    process process-form-ald-customer (
        name: Process form Ald Customer
        type: formAutoRowProcessing
        formRegion: @ald-customer
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25988005760702236
        }
    )

)
