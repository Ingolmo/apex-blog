genAIService open-ai (
    name: Open AI
    provider: openai
    endpointUrl {
        url: https://api.openai.com/v1
    }
    authentication {
        credentials: @credentials-for-open-ai
    }
    appBuilder {
        usedByAppBuilder: true
        defaultForNewApps: true
    }
    advanced {
        modelName: gpt-5.4-nano
    }
)

