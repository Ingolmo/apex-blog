            )

            displayColumn TITLE (
                sequence: 2
            )

        )

    )

    region v0-title (
        name: V0 · Metadatos técnicos
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
