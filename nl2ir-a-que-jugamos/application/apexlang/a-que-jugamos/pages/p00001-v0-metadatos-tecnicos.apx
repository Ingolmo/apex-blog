page 1 (
    name: V0 · Metadatos técnicos
    alias: V0-METADATOS-TECNICOS
    title: V0 · Metadatos técnicos
    pageGroup: @experimento-nl2ir
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Línea base del experimento. El informe conserva nombres y códigos técnicos, sin contexto adicional ni valores de referencia. Utiliza aquí las mismas preguntas que en las páginas siguientes.
    }

    region v0-report (
        name: V0 · Metadatos técnicos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.game_id
                     , l.title
                     , l.edition_ruleset
                     , l.cultural_scope
                     , l.game_type_code
                     , l.play_mode_code
                     , l.min_players
                     , l.max_players
                     , l.reference_duration_min
                     , l.complexity_code
                     , l.language_dep_code
                     , l.play_count
                     , l.avg_duration_min
                  from nl2ir_v_library l
                 order by l.title
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No hay juegos que coincidan con la configuración actual del informe.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# filas. Aplica algún filtro para acotar el resultado.
        }
        genAI {
            naturalLanguageSupport: true
        }
        download {
            formats: csv
        }
        advanced {
            savedReportMappingIdentifier: 29275202580367490
        }

        column AVG_DURATION_MIN (
            type: plainText
            heading {
                heading: AVG_DURATION_MIN
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column COMPLEXITY_CODE (
            type: plainText
            heading {
                heading: COMPLEXITY_CODE
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CULTURAL_SCOPE (
            type: plainText
            heading {
                heading: CULTURAL_SCOPE
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column EDITION_RULESET (
            type: plainText
