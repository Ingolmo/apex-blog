list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Cerrar sesión
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry v0 (
        label: V0 · Metadatos técnicos
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry v1 (
        label: V1 · Columnas comprensibles
        icon {
            imageIconCssClasses: fa-columns
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry v2 (
        label: V2 · Contexto
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry v3 (
        label: V3 · Valores de referencia
        icon {
            imageIconCssClasses: fa-list-ul
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry v4 (
        label: V4 · Columnas derivadas
        icon {
            imageIconCssClasses: fa-flask
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 5
            }
        }
    )

)

